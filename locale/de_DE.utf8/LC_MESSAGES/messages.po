msgstr "Gibt den (möglicherweise übersetzten) Fehlertext zum Fehlercode zurück"

#: api/includes/api_xml-rpc_definition.php:3646
msgid "Error codes"
msgstr "Fehlercodes"

#: api/includes/api_xml-rpc_definition.php:3647
msgid "An array of error codes to change into text messages. "
msgstr "Ein Array der Fehlerschlüssel zum Übersetzen in Textmeldungen. "

